[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "ggrcs"]
	path = ggrcs
	url = https://github.com/cran/ggrcs
[submodule "ggscidca"]
	path = ggscidca
	url = https://github.com/cran/ggscidca
[submodule "pm3"]
	path = pm3
	url = https://github.com/cran/pm3
[submodule "scitb"]
	path = scitb
	url = https://github.com/cran/scitb
